# Copy to assets/app.env — Project Settings → API (NOT the Postgres connection string).
# No spaces after = (e.g. SUPABASE_ANON_KEY=eyJ... or sb_publishable_...).

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_or_publishable_key_here

# Optional: use Oracle REST API instead of Supabase for schedule + bookings.
# Example (your local machine): ORACLE_API_BASE_URL=http://localhost:4010
# ORACLE_API_BASE_URL=

# Optional: only if your Edge Function slug is NOT “generate-training-week” (must match …/functions/v1/<slug>).
# SUPABASE_FN_GENERATE_TRAINING_WEEK=my-custom-slug

# Optional: pin one coach UUID for clients when you have several coaches.
# DEFAULT_COACH_ID=
