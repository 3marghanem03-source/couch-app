# Copy to assets/app.env — Project Settings → API (NOT the Postgres connection string).
# No spaces after = (e.g. SUPABASE_ANON_KEY=eyJ... or sb_publishable_...).

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_or_publishable_key_here

# Optional: pin one coach UUID for clients when you have several coaches.
# DEFAULT_COACH_ID=
