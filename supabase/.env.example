# Optional: Prisma, Drizzle, Supabase CLI, psql — NOT for Flutter.
# Copy to supabase/.env (gitignored). Use the Dashboard → Connect tab; never commit real passwords.

# --- Your project (ref: fohttdiwlcntblftpttu) ---

# Direct Postgres (db.* host, port 5432). Often IPv6-only; if the dashboard says
# "Not IPv4 compatible", use Session pooler below or enable the IPv4 add-on.
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.fohttdiwlcntblftpttu.supabase.co:5432/postgres"

# Recommended on IPv4-only networks: Dashboard → Connect → "Session pooler"
# (host/user include project ref; region is shown in the dashboard). Example shape:
# DATABASE_URL="postgresql://postgres.fohttdiwlcntblftpttu:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Or use port 5432 for session mode if the UI offers it for migrations — match what Connect shows.

# Pooled (transaction mode, 6543) — many short-lived app connections
# DATABASE_URL="postgresql://postgres.fohttdiwlcntblftpttu:[YOUR-PASSWORD]@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
